#cloud-config
# Dedicated to TEST VMs: allows password authentication (SSH + serial
# console). Do NOT use in production — prefer SSH keys.
# Required variable: password (via cloud_init.template_vars)
users:
  - name: oz_user
    groups: sudo
    shell: /bin/bash
    sudo: ['ALL=(ALL) NOPASSWD:ALL']
    lock_passwd: false
    ssh-authorized-keys:
%{ for key in ssh_keys ~}
      - ${key}
%{ endfor ~}

ssh_pwauth: true

chpasswd:
  expire: false
  list: |
    oz_user:${password}

package_upgrade: true

packages:
  - wireguard-tools
  - jq
  - curl

runcmd:
  - echo "VM provisioned successfully"
